Program Euclid;
  var fi,fo:text;
      T,k,i:byte;
      a,b,d,min,max:integer;
  begin
   assign(fi,'euclid2.in');
   reset(fi);
   readln(fi,T);
    for i:=1 to T do
      begin
        readln(fi,a,b);
        max:=a;
        min:=b;
        if a=b then d:=a;
        if (max<b) and (min>a) then
          begin max:=b;
                min:=a;
          end;
        for k:=2 to min do
          begin
            if ((max mod k)=0) and ((min mod k)=0)
            then d:=k
         end;
       close(fi);
       assign(fo,'euclid2.out');
       rewrite(fo);
       writeln(d);
       close(fo);
   end;
 end.




































































































































































































































































































































































































































































































































































































































































































































































































































































