


















Program Euclid;
  var fi,fo:text;
      t,i:byte;
      a,b,d,min,max:integer;
  begin
   assign(fi,'euclid2.in');
   reset(fi);
   readln(fi,T);
    for i:=1 to T do
      begin
        read(fi,a,b);
        max:=a;
        min:=b;
        if a=b then min:=a;
        if (max<b) and (min>a) then
          begin max:=b;
                min:=a;
          end;
        while (max mod min)>0 do
          begin
            d:=min;
            min:=max div min;
            max:=d;
          end;
        close(fi);
   assign(fo,'euclid2.out');
   rewrite(fo);
   writeln(min);
   close(fo);
   end;
 end.




































































































































































































































































































































































































































































































































































































































































































































































































































































